# Backend API
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Map tiles for "Set on map". Defaults to OpenStreetMap's free tiles, which
# are fine for testing and light use. For production traffic use a tile
# provider account (MapTiler, Stadia Maps, Carto, ...) and its attribution:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION